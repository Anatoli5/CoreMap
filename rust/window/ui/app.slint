// Окно CoreMap (DECISIONS #28, #32 шаг 2): верхняя полоса, строка отказа, три раздела — «Кристалл» (плитки блоков и
// полосы тепловой связи соседей), «Профили», «Статистика» выбранного блока — и меню потолка.
// Что и каким цветом показывать, решает Rust (src/view.rs, src/panels.rs): сюда приходят готовые строки, цвета и
// места в долях, отсюда уходят щелчки. Строка модели перерисовывается, только когда Rust её заменил, — а он заменяет
// только изменившуюся.
//
// Раскладка — числами, а не вложенными раскладками: по тем же числам скрытая проверка (src/check.rs) целится щелчками.
// Окно открывается по размеру содержимого (preferred-*): схема при масштабе 1 и панели по их естественной ширине; шире
// или выше — схема растёт по высоте окна, панели забирают остальную ширину. Пустых полей нет.

export struct CellData {
    text: string,      // номер ядра
    temp: string,      // «52°»
    fill: color,       // по температуре ядра
    num-color: color,  // цвет номера: E-ядро, красным — сбрасывает частоту
    col: int,          // место в кластере 2 × 2
    row: int,
}

export struct TileData {
    block: int,
    x: float,          // место на схеме в долях её ширины и высоты
    y: float,
    w: float,
    h: float,
    cluster: bool,     // кластер E-ядер: подложка с четырьмя клетками ядер, без обводки (обводка — только у выбранного)
    number: string,    // номер P-ядра
    number-color: color,
    cells: [CellData], // ядра кластера
    peak: string,      // «▲ 85°» — наибольшая с последнего сброса
    mean: string,      // средняя под нагрузкой: у P-ядра «ø 72° · ×50.8» (температура и множитель), у кластера «ø 72°»
    mean-ratio: string, // у кластера отдельной строкой: «ø ×50.8» — средний фактический множитель под нагрузкой
    temp: string,      // «45°» — сейчас (у P-ядра)
    fill: color,       // по температуре
    pair: string,      // «52.4 / ×53» — множитель сейчас / потолок
    pair-color: color, // жёлтый — потолок ниже заводского, красный — выше
    delta: string,     // разница с «было»: «−2»
    auto: string,      // поправка автомодуля: «авто −2»
    ban: bool,         // автомодулю нельзя поднимать обратно (память перегрева)
    strip: color,      // полоска слева — ▲ наибольшая цветом шкалы температуры
    selected: bool,    // в статистике
    outline: color,    // обводка выбранного — цвет его линии на графике
    tip: string,
}

export struct LinkData {
    x: float,
    y: float,
    w: float,
    h: float,
    color: color,
    tip: string,
}

export struct MenuEntry {
    ratio: int,
    text: string,
    hint: string,   // значки: ◆ заводской предел, ○ «было»
    checked: bool,
    above: bool,    // выше заводского — красным
}

export struct SetRow {
    name: string,       // «заводские» или название профиля
    standing: bool,     // стоит сейчас
    was: bool,          // «было»
    startup: bool,      // ставится при входе в Windows
    disabled: bool,     // профиль запуска отключён после сбоя
    selected: bool,
    p-mean: string,     // средний потолок набора по P-ядрам: «52.4»
    e-mean: string,     // и по E-ядрам
    tip: string,
}

export struct LineRow {
    time: string,
    head: string,
    text: string,
    color: color,
    mark: color,    // цвет блока (действия автомодуля при сравнении)
}

// Точка линии блока: место по оси множителя и высоты ø средней и ▲ наибольшей — доли поля графика; ø доля работы
// (0…1; < 0 — не известна) — заливка точки.
export struct Mark {
    x: float,
    mean: float,
    peak: float,
    load: float,
}

// Линия блока на графике статистики: пути в рамке 1000 × 1000, цвет блока, бледная — подсвечен другой.
export struct Series {
    mean: string,
    peak: string,
    color: color,
    faded: bool,
    marks: [Mark],
}

// Столбец множителя на оси: место, множитель, подсказка (что у каждого выбранного блока на нём; "" — ничего).
export struct Column {
    x: float,
    v: int,
    tip: string,
}

export struct LegendItem {
    name: string,
    color: color,
    tip: string,
}

export struct Tick {
    f: float,
    text: string,
}

export global Palette {
    out property <color> bg: #14161a;
    out property <color> panel: #1c1f25;
    out property <color> cell: #2a2e36;
    out property <color> line: #353a44;
    out property <color> text: #e6e8ec;
    out property <color> dim: #8b93a1;
    out property <color> accent: #ffd166;
    out property <color> bad: #ff5d5d;
    out property <color> warn-bg: #5a3d12;
    out property <color> warn-text: #ffd9a0;
    out property <color> p-text: #f0b860;   // P-ядро (Theme.KindText в C#-части)
    out property <color> e-text: #6fd0c8;   // E-ядро
    out property <color> plate: #23272e;    // подложка кластера E-ядер: светлее панели, без обводки
    out property <color> auto: #8fb8ff;     // поправка автомодуля
}

// Подсказка: обычный текст со строками (у встроенной подсказки Slint 1.18 текст — разметка, где перевод строки
// склеивается с соседней строкой); длинная строка переносится по словам.
component TipBox inherits Rectangle {
    in property <string> text;
    background: #262a31;
    border-radius: 5px;
    border-width: 1px;
    border-color: #3d4350;
    width: min(label.preferred-width, 460px) + 20px;
    height: label.preferred-height + 14px;
    label := Text {
        x: 10px;
        y: 7px;
        width: root.width - 20px;
        text: root.text;
        color: #e6e8ec;
        font-size: 12px;
        wrap: word-wrap;
    }
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    callback hover(bool);  // подсказку показывает окно (AppWindow.tip)
    border-radius: 4px;
    background: !root.enabled ? Palette.panel : touch.pressed ? Palette.line.brighter(0.2) : touch.has-hover ? Palette.line : Palette.cell;
    border-width: 1px;
    border-color: Palette.cell;
    Text {
        text: root.text;
        color: root.enabled ? Palette.text : Palette.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        changed has-hover => { root.hover(self.has-hover); }
    }
}

component TileView inherits Rectangle {
    in property <TileData> data;
    in property <float> scale: 1;   // масштаб схемы: размеры ниже — при масштабе 1
    callback clicked();
    callback menu(length, length);  // правая кнопка: где, в координатах окна
    callback hover(bool);           // курсор над плиткой или ушёл: подсказку показывает окно

    property <length> u: 1px * root.scale;
    property <length> small: max(10px, 12 * root.u);
    property <length> line: root.small * 1.3;
    property <length> pad: 6 * root.u;
    property <length> strip-w: 4 * root.u;
    // Колонка чисел справа: у P-ядра от края, у кластера — справа от клеток ядер.
    property <length> cell-w: 38 * root.u;
    property <length> cell-gap: 4 * root.u;
    property <length> cells-x: root.strip-w + 4 * root.u;
    property <length> cells-w: 2 * root.cell-w + root.cell-gap;

    // Кластер — подложка с клетками ядер; обводки нет: обводка значит «выбран» (владелец 15.10).
    background: data.cluster ? Palette.plate : data.fill;
    border-radius: 6 * root.u;

    // Полоска слева — ▲ наибольшая цветом той же шкалы, что плитка: какое ядро грелось сильнее остальных.
    Rectangle {
        x: 0;
        y: 0;
        width: root.strip-w;
        height: root.height;
        background: data.strip;
        border-top-left-radius: 6 * root.u;
        border-bottom-left-radius: 6 * root.u;
    }
    if !data.cluster: Text {
        x: 10 * root.u;
        y: root.pad;
        text: data.number;
        color: data.number-color;
        font-size: root.small;
        font-weight: 600;
    }
    if !data.cluster: Text {
        x: 10 * root.u;
        y: root.height - root.pad - self.height;
        text: data.temp;
        color: Palette.text;
        font-size: max(14px, 26 * root.u);
        font-weight: 600;
    }

    // Кластер E-ядер: четыре клетки ядер 2 × 2 — у каждой своя температура и свой цвет; потолок у кластера один.
    for cell in data.cells: Rectangle {
        x: root.cells-x + cell.col * (root.cell-w + root.cell-gap);
        y: root.pad + cell.row * ((root.height - 2 * root.pad - root.cell-gap) / 2 + root.cell-gap);
        width: root.cell-w;
        height: (root.height - 2 * root.pad - root.cell-gap) / 2;
        background: cell.fill;
        border-radius: 4 * root.u;
        Text {
            x: 4 * root.u;
            y: 2 * root.u;
            text: cell.text;
            color: cell.num-color;
            font-size: max(9px, 10 * root.u);
            font-weight: 600;
        }
        Text {
            x: 0;
            width: parent.width - 4 * root.u;
            y: parent.height - self.height - 2 * root.u;
            horizontal-alignment: right;
            text: cell.temp;
            color: Palette.text;
            font-size: max(10px, 15 * root.u);
            font-weight: 600;
        }
    }

    // Числа справа. P-ядро: ▲ наибольшая, ø средняя и ø множитель под нагрузкой, внизу — множитель / потолок.
    // Кластер: то же столбцом — по строке на число.
    VerticalLayout {
        x: data.cluster ? root.cells-x + root.cells-w + 6 * root.u : 0;
        y: root.pad - 2 * root.u;
        width: root.width - self.x - 8 * root.u;
        height: root.height - 2 * root.pad + 4 * root.u;
        spacing: 0;
        alignment: space-between;
        Text { text: data.peak; color: Palette.text; font-size: root.small; horizontal-alignment: right; }
        if data.cluster: Text { text: data.mean; color: Palette.text; font-size: root.small; horizontal-alignment: right; }
        if data.cluster: Text { text: data.mean-ratio; color: Palette.text; font-size: root.small; horizontal-alignment: right; }
        if !data.cluster: Text { text: data.mean; color: Palette.text; font-size: root.small; horizontal-alignment: right; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: 5 * root.u;
            if data.auto != "": Rectangle {
                width: auto-text.preferred-width + 8 * root.u;
                background: #10203a;
                border-radius: 3 * root.u;
                border-width: data.ban ? 1px : 0;
                border-color: Palette.bad;
                auto-text := Text { text: data.auto; color: Palette.auto; font-size: root.small; horizontal-alignment: center; }
            }
            Text { text: data.pair; color: data.pair-color; font-size: root.small; }
            if data.delta != "": Text { text: data.delta; color: Palette.text; font-size: root.small; font-weight: 600; }
        }
    }

    // Выбран (в статистике): обводка цветом его линии на графике.
    if data.selected: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-width: 2.5px;
        border-color: data.outline;
        border-radius: 6 * root.u + 3px;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        changed has-hover => { root.hover(self.has-hover); }
    }
}

// График «температура от фактического множителя» выбранных блоков: у каждого блока своя линия своего цвета —
// толстая ø средняя, тонкая ▲ наибольшая. Оси общие для всех блоков (владелец 15.10): множитель — числовая ось с
// подписью через 1, 2 или 5 ступеней, сколько помещается; температура — 40–100 °C. Отсечка автомодуля — красной
// линией. Подсвеченная линия рисуется последней (Rust ставит её в конец), остальные тогда бледнее.
component Chart inherits Rectangle {
    in property <[Series]> series;
    in property <[Column]> cols;
    in property <[Tick]> yticks;
    in property <string> empty;     // вместо графика, когда точек нет
    in property <float> columns: 1; // сколько множителей на оси
    in property <float> cutoff: -1; // отсечка автомодуля — доля высоты поля; < 0 — нет
    in property <string> cutoff-text;
    callback tip(bool, string, string, length, length, length, length); // как AppWindow.tip
    // Курсор над полем (от его левого верхнего угла) и размер поля: Rust ищет ближайшую линию.
    callback pointer(length, length, length, length);
    callback exited();
    callback clicked-at(length, length, length, length);

    property <length> left: 40px;
    property <length> axis-h: 34px;
    out property <length> plot-x: root.left;
    out property <length> plot-y: 8px;
    out property <length> plot-w: root.width - root.left - 10px;
    out property <length> plot-h: root.height - root.plot-y - root.axis-h;
    property <length> col-w: root.plot-w / max(1, root.columns);
    // Подпись каждого множителя, каждого второго или каждого пятого — по ширине столбца.
    property <int> step: root.col-w >= 20px ? 1 : root.col-w >= 10px ? 2 : 5;
    property <bool> drawn: root.empty == "" && root.cols.length > 0;

    if root.empty != "": Text {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        text: root.empty;
        color: Palette.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    for t in root.yticks: Rectangle {
        x: root.plot-x;
        y: root.plot-y + (1 - t.f) * root.plot-h;
        width: root.plot-w;
        height: 1px;
        background: Palette.line;
    }
    for t in root.yticks: Text {
        x: 0;
        width: root.left - 6px;
        y: root.plot-y + (1 - t.f) * root.plot-h - 8px;
        height: 16px;
        text: t.text;
        color: Palette.dim;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Столбец под курсором — подсветка (подсказка с числами — у окна).
    if plot-touch.has-hover && root.cols[plot-touch.at-col].tip != "": Rectangle {
        x: root.plot-x + plot-touch.at-col * root.col-w;
        y: root.plot-y;
        width: root.col-w;
        height: root.plot-h;
        background: #ffffff0c;
    }

    // Отсечка автомодуля.
    if root.drawn && root.cutoff >= 0: Rectangle {
        x: root.plot-x;
        y: root.plot-y + (1 - root.cutoff) * root.plot-h;
        width: root.plot-w;
        height: 1px;
        background: Palette.bad.transparentize(0.25);
    }
    if root.drawn && root.cutoff >= 0: Text {
        x: root.plot-x;
        width: root.plot-w - 4px;
        y: root.plot-y + (1 - root.cutoff) * root.plot-h - 15px;
        text: "отсечка " + root.cutoff-text;
        color: Palette.bad;
        font-size: 10px;
        horizontal-alignment: right;
    }

    // Линии блоков: пути в рамке 1000 × 1000 растягиваются на поле (толщина линии — снаружи поля).
    for s in root.series: Rectangle {
        x: root.plot-x;
        y: root.plot-y;
        width: root.plot-w;
        height: root.plot-h;
        opacity: s.faded ? 0.3 : 1;
        Path {
            x: -1px;
            y: -1px;
            width: parent.width + 2px;
            height: parent.height + 2px;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: fill;
            commands: s.peak;
            stroke: s.color.transparentize(0.45);
            stroke-width: 1.5px;
        }
        Path {
            x: -1.5px;
            y: -1.5px;
            width: parent.width + 3px;
            height: parent.height + 3px;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: fill;
            commands: s.mean;
            stroke: s.color;
            stroke-width: 3px;
            stroke-line-join: round;
        }
        for m in s.marks: Text {
            x: m.x * parent.width - 6px;
            y: (1 - m.peak) * parent.height - 8px;
            width: 12px;
            height: 14px;
            text: "▲";
            color: s.color.transparentize(0.2);
            font-size: 9px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // Точка ø средней — кольцо цвета блока, залитое по ø нагрузке: площадь заливки — её доля (пустое — 0 %,
        // полное — 100 %; владелец 15.10 о нагрузке: «от 0 до 100»).
        for m in s.marks: Rectangle {
            x: m.x * parent.width - 5px;
            y: (1 - m.mean) * parent.height - 5px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Palette.panel;
            border-width: 1.5px;
            border-color: s.color;
            Rectangle {
                property <length> d: 10px * Math.sqrt(max(0, m.load));
                x: (parent.width - self.d) / 2;
                y: (parent.height - self.d) / 2;
                width: self.d;
                height: self.d;
                border-radius: self.d / 2;
                background: s.color;
            }
        }
    }

    // Ось множителя: черта на каждый, подпись — через шаг; название оси справа.
    if root.drawn: Rectangle {
        x: root.plot-x;
        y: root.plot-y + root.plot-h;
        width: root.plot-w;
        height: 1px;
        background: Palette.dim;
    }
    for c in root.cols: Rectangle {
        x: root.plot-x + c.x * root.plot-w;
        y: root.plot-y + root.plot-h;
        width: 1px;
        height: Math.mod(c.v, root.step) == 0 ? 5px : 3px;
        background: Palette.dim;
    }
    for c in root.cols: Text {
        visible: Math.mod(c.v, root.step) == 0;
        x: root.plot-x + c.x * root.plot-w - 15px;
        width: 30px;
        y: root.plot-y + root.plot-h + 6px;
        text: "\{c.v}";
        color: Palette.text;
        font-size: 11px;
        horizontal-alignment: center;
    }
    if root.drawn: Text {
        x: root.plot-x;
        width: root.plot-w;
        y: root.plot-y + root.plot-h + 20px;
        text: "множитель, ×";
        color: Palette.dim;
        font-size: 10px;
        horizontal-alignment: right;
    }

    // Одна область касания на всё поле: столбец под курсором (подсказка), ближайшая линия (Rust), щелчок.
    plot-touch := TouchArea {
        x: root.plot-x;
        y: root.plot-y;
        width: root.plot-w;
        height: root.plot-h;
        enabled: root.drawn;
        out property <int> at-col: max(0, min(root.cols.length - 1, floor(self.mouse-x / root.col-w)));
        function show() {
            root.tip(true, "col" + self.at-col, root.cols[self.at-col].tip, self.absolute-position.x + self.at-col * root.col-w, self.absolute-position.y, root.col-w, root.plot-h);
        }
        changed at-col => {
            if (self.has-hover) {
                self.show();
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                self.show();
            } else {
                root.tip(false, "col" + self.at-col, "", 0, 0, 0, 0);
                root.exited();
            }
        }
        changed mouse-x => {
            if (self.has-hover) {
                root.pointer(self.mouse-x, self.mouse-y, self.width, self.height);
            }
        }
        changed mouse-y => {
            if (self.has-hover) {
                root.pointer(self.mouse-x, self.mouse-y, self.width, self.height);
            }
        }
        clicked => { root.clicked-at(self.mouse-x, self.mouse-y, self.width, self.height); }
    }
}

// Список строк (история профилей, действия автомодуля): время, заголовок, текст; прокручивается.
component Lines inherits Flickable {
    in property <[LineRow]> rows;
    in property <length> row-h: 18px;
    in property <string> empty;
    in property <bool> marks;   // у строк есть цвет блока — квадратик перед заголовком
    callback tip(bool, string, string, length, length, length, length); // как AppWindow.tip
    content-height: max(self.height, root.rows.length * root.row-h);
    if root.rows.length == 0: Text {
        y: 0;
        height: root.row-h;
        text: root.empty;
        color: Palette.dim;
        font-size: 12px;
    }
    for r[i] in root.rows: HorizontalLayout {
        y: i * root.row-h;
        height: root.row-h;
        width: root.width;
        spacing: 8px;
        Text { text: r.time; color: Palette.dim; font-size: 12px; width: 70px; vertical-alignment: center; }
        if root.marks: Rectangle {
            width: 8px;
            Rectangle { y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 2px; background: r.mark; }
        }
        if r.head != "": Text { text: r.head; color: r.color; font-size: 12px; vertical-alignment: center; }
        Text { text: r.text; color: Palette.text; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    for r[i] in root.rows: TouchArea {
        y: i * root.row-h;
        height: root.row-h;
        width: root.width;
        changed has-hover => {
            root.tip(self.has-hover, "line" + i + r.time, r.time + "  " + r.head + "  " + r.text, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
        }
    }
}

export component AppWindow inherits Window {
    in property <string> version;  // номер версии (файл VERSION); «без номера» — собрано не скриптом tools\rust.ps1
    title: "CoreMap " + root.version;
    background: Palette.bg;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in property <string> cpu;
    in property <string> pkg;
    in property <string> watts;
    in property <string> fans;
    in property <string> link;
    in property <bool> link-down;
    in property <string> problem;
    in property <[TileData]> tiles;
    in property <[LinkData]> links;
    in property <bool> link-legend;   // есть полосы связи — под схемой их шкала
    in property <string> note;        // приписка к раскладке (не подтверждена) — подсказкой у заголовка
    in property <string> menu-title;
    in property <[MenuEntry]> menu-entries;
    in property <bool> busy;
    // Схема при масштабе 1 (src/die.rs): из неё — размер, с которым окно открывается.
    in property <length> die-nat-w: 356px;
    in property <length> die-nat-h: 580px;

    // Профили
    in property <bool> has-profiles;
    in property <string> prof-was;
    in property <string> prof-now;
    in property <bool> prof-attention;
    in property <[SetRow]> sets;
    in-out property <string> prof-name;
    in property <bool> can-open;
    in property <bool> can-save;
    in property <bool> can-save-as;
    in property <bool> can-accept;
    in property <bool> can-revert;
    in property <bool> can-delete;
    in property <string> save-tip;
    in property <string> save-as-text: "сохранить как";
    in property <string> save-note;
    in property <[LineRow]> history;
    in property <bool> has-history;

    // Статистика
    in property <string> stats-note;
    in property <[LegendItem]> stats-legend;   // выбранные блоки: цвет линии и название
    in property <[Series]> chart-series;
    in property <[Column]> chart-cols;
    in property <[Tick]> chart-yticks;
    in property <string> chart-empty;
    in property <float> chart-columns: 1;
    in property <float> chart-cutoff: -1;
    in property <string> chart-cutoff-text;
    in property <[LineRow]> actions;
    in property <string> actions-empty;
    // Подсветка линий: false — под курсором, true — закреплённая (владелец 15.10: попробовать обе).
    in property <bool> pin-mode;
    // Середины кнопок переключателя — по ним щёлкает скрытая проверка (src/check.rs).
    out property <length> hover-chip-x: hover-chip.absolute-position.x + hover-chip.width / 2;
    out property <length> hover-chip-y: hover-chip.absolute-position.y + hover-chip.height / 2;
    out property <length> pin-chip-x: pin-chip.absolute-position.x + pin-chip.width / 2;
    out property <length> pin-chip-y: pin-chip.absolute-position.y + pin-chip.height / 2;

    callback tile-clicked(int);
    callback tile-hover(int, bool);
    callback chart-pointer(length, length, length, length);
    callback chart-left();
    callback chart-click(length, length, length, length);
    callback mode-changed(bool);
    callback tile-menu(int);      // Rust заполняет menu-title и menu-entries, затем меню открывается
    callback limit-chosen(int);
    callback problem-dismissed();
    callback reset-max();
    callback set-clicked(int);
    callback profile-open();
    callback profile-save();
    callback profile-save-as();
    callback profile-accept();
    callback profile-revert();
    callback profile-delete();
    callback name-edited();

    // Подсказка — одна на окно: под элементом (над ним, если внизу нет места), в пределах окна, через 450 мс
    // наведения. key — чей это текст: уход курсора с другого элемента её не гасит.
    property <string> tip-key;
    property <string> tip-text;
    property <length> tip-x;
    property <length> tip-y;
    property <length> tip-w;
    property <length> tip-h;
    property <bool> tip-wanted;
    out property <bool> tip-shown;
    function tip(on: bool, key: string, text: string, x: length, y: length, w: length, h: length) {
        if (on) {
            root.tip-key = key;
            root.tip-text = text;
            root.tip-x = x;
            root.tip-y = y;
            root.tip-w = w;
            root.tip-h = h;
            root.tip-shown = false;
            root.tip-wanted = text != "";
        } else if (root.tip-key == key) {
            root.tip-wanted = false;
            root.tip-shown = false;
        }
    }
    Timer {
        interval: 450ms;
        running: root.tip-wanted && !root.tip-shown;
        triggered() => { root.tip-shown = true; }
    }

    out property <length> top-h: 36px;
    property <length> problem-h: root.problem != "" ? 30px : 0px;
    out property <length> margin: 12px;
    out property <length> pad: 12px;
    out property <length> head-h: 32px;
    property <length> legend-h: 24px;
    property <length> prof-nat-w: 340px;
    property <length> stats-nat-w: 470px;
    property <length> stats-min-w: 380px;

    // Размер по содержимому: схема при масштабе 1 и панели по естественной ширине.
    out property <length> natural-w: root.margin + root.die-nat-w + 2 * root.pad + root.margin + root.prof-nat-w + root.margin + root.stats-nat-w + root.margin;
    out property <length> natural-h: root.top-h + root.margin + root.head-h + root.die-nat-h + root.legend-h + root.pad + root.margin;
    preferred-width: root.natural-w;
    preferred-height: root.natural-h;
    min-width: 900px;
    min-height: 560px;

    // Схема растёт по высоте окна, но оставляет панелям их наименьшую ширину.
    out property <length> body-y: root.top-h + root.problem-h + root.margin;
    property <length> body-h: root.height - root.body-y - root.margin;
    property <float> scale-h: (root.body-h - root.head-h - root.legend-h - root.pad) / root.die-nat-h;
    property <float> scale-w: (root.width - 5 * root.margin - 2 * root.pad - 300px - root.stats-min-w) / root.die-nat-w;
    out property <float> scale: max(0.5, min(root.scale-h, root.scale-w));
    out property <length> die-w: root.die-nat-w * root.scale;
    out property <length> die-h: root.die-nat-h * root.scale;
    out property <length> die-x: root.margin + root.pad;
    out property <length> die-y: root.body-y + root.head-h;

    // Панели справа от схемы: профили — до 420 px, статистика — остальное.
    property <length> right-x: root.margin + root.die-w + 2 * root.pad + root.margin;
    property <length> right-w: root.width - root.right-x - root.margin;
    out property <length> prof-x: root.right-x;
    // По содержимому окна — естественная ширина; шире окно — растёт до 420 px, остальное — статистике.
    out property <length> prof-w: max(300px, min(420px, root.right-w - root.stats-nat-w - root.margin));
    out property <length> stats-x: root.prof-x + root.prof-w + root.margin;
    out property <length> stats-w: root.width - root.stats-x - root.margin;

    // Профили: где что лежит (скрытая проверка целится по этим же числам).
    out property <length> btn-h: 26px;
    out property <length> btn-w: 88px;
    out property <length> btn-gap: 6px;
    out property <length> set-h: 26px;
    property <length> mean-w: 40px;  // столбец среднего потолка набора («52.4»)
    out property <length> row-a-y: root.body-y + root.head-h + 40px;
    out property <length> sets-y: root.row-a-y + root.btn-h + 26px;
    property <length> below-sets: 6px + root.btn-h + 6px + root.btn-h + 4px + 18px + (root.has-history ? 30px + 3 * 18px : 0px) + root.pad;
    property <length> sets-room: root.body-y + root.body-h - root.sets-y - root.below-sets;
    out property <length> sets-h: root.has-history ? max(min(3, root.sets.length) * root.set-h + 4px, min(root.sets.length * root.set-h + 4px, root.sets-room)) : root.sets-room;
    out property <length> row-b-y: root.sets-y + root.sets-h + 6px;
    out property <length> row-c-y: root.row-b-y + root.btn-h + 6px;
    property <length> note-y: root.row-c-y + root.btn-h + 4px;
    property <length> hist-y: root.note-y + 18px + 8px;

    // Статистика
    property <length> actions-h: min(6, max(1, root.actions.length)) * 18px;
    out property <length> chart-y: root.body-y + root.head-h + 22px;
    out property <length> chart-h: root.body-y + root.body-h - root.pad - root.actions-h - 28px - root.chart-y;

    out property <length> menu-x;
    out property <length> menu-y;
    out property <bool> menu-shown;
    out property <length> menu-head-h: 52px;  // заголовок и строка расшифровки значков
    out property <length> entry-h: 26px;
    property <length> menu-w: 290px;  // строка расшифровки значков помещается целиком
    out property <length> menu-left: min(root.menu-x, root.width - root.menu-w);
    // Меню выше окна (потолков десятки) прокручивается внутри окна.
    out property <length> menu-h: min(root.menu-head-h + root.menu-entries.length * root.entry-h + 4px, root.height - 16px);
    out property <length> menu-top: max(0px, min(root.menu-y, root.height - root.menu-h - 8px));

    // Верхняя полоса
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.top-h;
        background: Palette.panel;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 24px;
            Text { text: root.cpu; color: Palette.dim; vertical-alignment: center; }
            Text { text: root.pkg; color: Palette.text; vertical-alignment: center; }
            Text { text: root.watts; color: Palette.text; vertical-alignment: center; }
            Text { text: root.fans; color: Palette.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.link; color: root.link-down ? Palette.bad : Palette.dim; vertical-alignment: center; }
        }
    }

    // Почему движок не выполнил последнюю команду; щелчок убирает строку.
    if root.problem != "": Rectangle {
        x: 0;
        y: root.top-h;
        width: root.width;
        height: root.problem-h;
        background: Palette.warn-bg;
        Text {
            x: 16px;
            text: root.problem;
            color: Palette.warn-text;
            vertical-alignment: center;
            height: parent.height;
        }
        TouchArea { clicked => { root.problem-dismissed(); } }
    }

    // ----- Кристалл -----
    Rectangle {
        x: root.margin;
        y: root.body-y;
        width: root.die-w + 2 * root.pad;
        height: root.body-h;
        background: Palette.panel;
        border-radius: 8px;
        Text {
            x: root.pad;
            y: 9px;
            text: "Кристалл";
            color: Palette.dim;
            font-weight: 600;
        }
        if root.note != "": Rectangle {
            x: root.pad + 76px;
            y: 6px;
            width: 22px;
            height: 22px;
            Text { text: "≈"; color: Palette.dim; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea {
                changed has-hover => {
                    root.tip(self.has-hover, "note", "Схема — оценка\n" + root.note, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                }
            }
        }
        // Сброс ▲ и ø: значок «по кругу» и те же знаки, что на плитках.
        reset := Rectangle {
            x: parent.width - root.pad - 64px;
            y: 4px;
            width: 64px;
            height: 24px;
            border-radius: 4px;
            background: reset-touch.pressed ? Palette.line.brighter(0.2) : reset-touch.has-hover ? Palette.line : Palette.cell;
            Path {
                x: 7px;
                y: 4px;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 19.5 12 A 7.5 7.5 0 1 1 16.8 6.2 M 17.5 1.8 L 17.5 6.6 L 12.7 6.6";
                stroke: Palette.text;
                stroke-width: 2px;
                fill: transparent;
            }
            Text { x: 27px; text: "▲ ø"; color: Palette.text; font-size: 12px; vertical-alignment: center; height: parent.height; }
            reset-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.reset-max(); }
                changed has-hover => {
                    root.tip(self.has-hover, "reset", "Сбросить максимумы и средние\nОбнуляет ▲ наибольшую температуру и ø средние под нагрузкой (температуру и множитель)\nна всех плитках — дальше они считаются заново.", self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                }
            }
        }
        if root.link-legend: HorizontalLayout {
            alignment: start;
            x: root.pad;
            y: root.head-h + root.die-h + 4px;
            height: root.legend-h - 4px;
            spacing: 6px;
            // Шкала полос связи — та же, что LINK_SCALE в src/panels.rs: плавная, от серого (0°) до красного (6° и больше).
            Text { text: "сосед занят — ядро горячее на"; color: Palette.dim; font-size: 11px; vertical-alignment: center; }
            Text { text: "0°"; color: Palette.dim; font-size: 11px; vertical-alignment: center; }
            Rectangle {
                width: 72px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: @linear-gradient(90deg, #5b616d 0%, #e8c547 25%, #ff9f43 58%, #ff5d5d 100%);
            }
            Text { text: "6°+"; color: Palette.dim; font-size: 11px; vertical-alignment: center; }
        }
    }

    for tile in root.tiles: TileView {
        x: root.die-x + tile.x * root.die-w;
        y: root.die-y + tile.y * root.die-h;
        width: tile.w * root.die-w;
        height: tile.h * root.die-h;
        scale: root.scale;
        data: tile;
        clicked => { root.tile-clicked(tile.block); }
        hover(on) => {
            root.tip(on, "tile" + tile.block, tile.tip, self.x, self.y, self.width, self.height);
            root.tile-hover(tile.block, on);
        }
        menu(x, y) => {
            root.menu-x = x;
            root.menu-y = y;
            root.tile-menu(tile.block);
            root.menu-shown = true;
            keys.focus();
        }
    }

    for link[i] in root.links: Rectangle {
        x: root.die-x + link.x * root.die-w;
        y: root.die-y + link.y * root.die-h;
        width: link.w * root.die-w;
        height: link.h * root.die-h;
        // Полоса в промежутке между соседями: толще и краснее — сильнее связь (src/panels.rs, link_color).
        background: link.color;
        border-radius: min(self.width, self.height) / 2;
        TouchArea {
            changed has-hover => {
                root.tip(self.has-hover, "link" + i, link.tip, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
            }
        }
    }

    // ----- Профили -----
    Rectangle {
        x: root.prof-x;
        y: root.body-y;
        width: root.prof-w;
        height: root.body-h;
        background: Palette.panel;
        border-radius: 8px;
        Text { x: root.pad; y: 9px; text: "Профили"; color: Palette.dim; font-weight: 600; }
        if !root.has-profiles: Text {
            x: root.pad;
            y: root.head-h;
            width: parent.width - 2 * root.pad;
            text: "Профилей нет: движок не прислал их (потолки недоступны или он их не знает).";
            color: Palette.dim;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
    if root.has-profiles: Text {
        x: root.prof-x + root.pad;
        y: root.body-y + root.head-h;
        width: root.prof-w - 2 * root.pad;
        text: root.prof-was;
        color: Palette.dim;
        font-size: 12px;
        overflow: elide;
    }
    if root.has-profiles: Text {
        x: root.prof-x + root.pad;
        y: root.body-y + root.head-h + 18px;
        width: root.prof-w - 2 * root.pad;
        text: root.prof-now;
        color: root.prof-attention ? Palette.accent : Palette.dim;
        font-size: 12px;
        overflow: elide;
    }
    // Строки «было / сейчас» обрезаются по ширине панели: целиком — в подсказке.
    if root.has-profiles: TouchArea {
        x: root.prof-x + root.pad;
        y: root.body-y + root.head-h;
        width: root.prof-w - 2 * root.pad;
        height: 36px;
        changed has-hover => {
            root.tip(self.has-hover, "status", root.prof-was + "\n" + root.prof-now, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
        }
    }
    if root.has-profiles: Btn {
        x: root.prof-x + root.pad;
        y: root.row-a-y;
        width: root.btn-w;
        height: root.btn-h;
        text: "принять";
        enabled: root.can-accept;
        tip: "Принять то, что стоит сейчас\nТекущие потолки становятся «было»: разница на плитках обнуляется, «откатить» будет возвращать к ним.\n• если стоит сохранённый профиль — он же будет ставиться при входе в Windows\n• если стоят заводские — при входе ничего ставиться не будет\n• несохранённые потолки тоже можно принять, но после перезагрузки их не будет — для этого «сохранить»";
        clicked => { root.profile-accept(); }
        hover(on) => { root.tip(on, "accept", self.tip, self.x, self.y, self.width, self.height); }
    }
    if root.has-profiles: Btn {
        x: root.prof-x + root.pad + root.btn-w + root.btn-gap;
        y: root.row-a-y;
        width: root.btn-w;
        height: root.btn-h;
        text: "откатить";
        enabled: root.can-revert;
        tip: "Откатить к «было»\nВозвращает потолки, которые были приняты последними (или прочитаны при запуске).\n• всё, что менялось после этого, отменяется\n• сохранённые профили не меняются";
        clicked => { root.profile-revert(); }
        hover(on) => { root.tip(on, "revert", self.tip, self.x, self.y, self.width, self.height); }
    }
    // Значки списка — строкой над ним; справа — заголовки столбцов среднего потолка набора по P- и по E-ядрам.
    if root.has-profiles: Text {
        x: root.prof-x + root.pad;
        y: root.row-a-y + root.btn-h + 6px;
        width: root.prof-w - 2 * root.pad - 2 * root.mean-w - 8px;
        height: 16px;
        text: "● стоит   ○ было   ► при входе";
        color: Palette.dim;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.has-profiles: Rectangle {
        x: root.prof-x + root.prof-w - root.pad - 2 * root.mean-w - 8px;
        y: root.row-a-y + root.btn-h + 6px;
        width: 2 * root.mean-w;
        height: 16px;
        Text { x: 0; width: root.mean-w; height: parent.height; text: "ø P"; color: Palette.dim; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: root.mean-w; width: root.mean-w; height: parent.height; text: "ø E"; color: Palette.dim; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
        TouchArea {
            changed has-hover => {
                root.tip(self.has-hover, "means", "Средний потолок набора\nПо P-ядрам и по E-ядрам отдельно — оценка уровня набора: выше — быстрее.\n• это потолки, а не фактические множители: под нагрузкой ядро может идти ниже", self.absolute-position.x, self.absolute-position.y, self.width, self.height);
            }
        }
    }

    if root.has-profiles: Flickable {
        x: root.prof-x + root.pad;
        y: root.sets-y;
        width: root.prof-w - 2 * root.pad;
        height: root.sets-h;
        content-height: max(self.height, root.sets.length * root.set-h);
        for s[i] in root.sets: Rectangle {
            y: i * root.set-h;
            height: root.set-h;
            width: parent.width;
            border-radius: 4px;
            background: s.selected ? Palette.line : set-touch.has-hover ? Palette.cell : transparent;
            Text { x: 6px; width: 12px; text: s.standing ? "●" : ""; color: Palette.text; font-size: 12px; vertical-alignment: center; height: parent.height; }
            Text { x: 18px; width: 12px; text: s.was ? "○" : ""; color: Palette.text; font-size: 12px; vertical-alignment: center; height: parent.height; }
            Text { x: 30px; width: 12px; text: s.startup ? "►" : ""; color: s.disabled ? Palette.bad : Palette.accent; font-size: 11px; vertical-alignment: center; height: parent.height; }
            Text {
                x: 46px;
                width: parent.width - 46px - 2 * root.mean-w - 12px;
                text: s.name;
                color: Palette.text;
                font-size: 13px;
                vertical-alignment: center;
                height: parent.height;
                overflow: elide;
            }
            // Средний потолок набора по P- и по E-ядрам — для сравнения наборов между собой.
            Text { x: parent.width - 8px - 2 * root.mean-w; width: root.mean-w; height: parent.height; text: s.p-mean; color: Palette.text; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            Text { x: parent.width - 8px - root.mean-w; width: root.mean-w; height: parent.height; text: s.e-mean; color: Palette.text; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            set-touch := TouchArea {
                clicked => { root.set-clicked(i); }
                changed has-hover => {
                    root.tip(self.has-hover, "set" + i, s.tip, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                }
            }
        }
    }

    if root.has-profiles: Btn {
        x: root.prof-x + root.pad;
        y: root.row-b-y;
        width: root.btn-w;
        height: root.btn-h;
        text: "открыть";
        enabled: root.can-open;
        tip: "Открыть выбранный набор\nСтавит его потолки. «Было» остаётся прежним — разница видна на плитках (+N, −N).\n• оставить — «принять»; вернуться — «откатить»";
        clicked => { root.profile-open(); }
        hover(on) => { root.tip(on, "open", self.tip, self.x, self.y, self.width, self.height); }
    }
    if root.has-profiles: Btn {
        x: root.prof-x + root.pad + root.btn-w + root.btn-gap;
        y: root.row-b-y;
        width: root.btn-w;
        height: root.btn-h;
        text: "сохранить";
        enabled: root.can-save;
        tip: root.save-tip;
        clicked => { root.profile-save(); }
        hover(on) => { root.tip(on, "save", self.tip, self.x, self.y, self.width, self.height); }
    }
    if root.has-profiles: Btn {
        x: root.prof-x + root.pad + 2 * (root.btn-w + root.btn-gap);
        y: root.row-b-y;
        width: root.btn-w;
        height: root.btn-h;
        text: "удалить";
        enabled: root.can-delete;
        tip: "Удалить выбранный профиль\n• если он ставился при входе в Windows — больше ничего ставиться не будет\n• потолки, которые стоят сейчас, остаются до перезагрузки";
        clicked => { root.profile-delete(); }
        hover(on) => { root.tip(on, "delete", self.tip, self.x, self.y, self.width, self.height); }
    }
    if root.has-profiles: Rectangle {
        x: root.prof-x + root.pad;
        y: root.row-c-y;
        width: root.prof-w - 2 * root.pad - 128px - root.btn-gap;
        height: root.btn-h;
        background: Palette.bg;
        border-radius: 4px;
        border-width: 1px;
        border-color: name-input.has-focus ? Palette.accent : Palette.cell;
        name-input := TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            color: Palette.text;
            font-size: 13px;
            text <=> root.prof-name;
            edited => { root.name-edited(); }
            accepted => { if (root.can-save-as) { root.profile-save-as(); } }
        }
        if root.prof-name == "": Text {
            x: 6px;
            height: parent.height;
            vertical-alignment: center;
            text: "новое название";
            color: Palette.dim;
            font-size: 12px;
        }
    }
    if root.has-profiles: Btn {
        x: root.prof-x + root.prof-w - root.pad - 128px;
        y: root.row-c-y;
        width: 128px;
        height: root.btn-h;
        text: root.save-as-text;
        enabled: root.can-save-as;
        tip: "Сохранить как профиль с названием из поля\nЗаписывает то, что стоит сейчас, и принимает его: он становится «было» и ставится при входе в Windows.\n• название уже есть — тот профиль перезаписывается";
        clicked => { root.profile-save-as(); }
        hover(on) => { root.tip(on, "save-as", self.tip, self.x, self.y, self.width, self.height); }
    }
    if root.has-profiles: Text {
        x: root.prof-x + root.pad;
        y: root.note-y;
        width: root.prof-w - 2 * root.pad;
        height: 18px;
        text: root.save-note;
        color: Palette.dim;
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.has-profiles && root.has-history: Text {
        x: root.prof-x + root.pad;
        y: root.hist-y;
        text: "История";
        color: Palette.dim;
        font-weight: 600;
        font-size: 12px;
    }
    if root.has-profiles && root.has-history: Lines {
        x: root.prof-x + root.pad;
        y: root.hist-y + 20px;
        width: root.prof-w - 2 * root.pad;
        height: root.body-y + root.body-h - root.pad - self.y;
        rows: root.history;
        empty: "смен профиля ещё не было";
        tip(on, key, text, x, y, w, h) => { root.tip(on, key, text, x, y, w, h); }
    }

    // ----- Статистика -----
    Rectangle {
        x: root.stats-x;
        y: root.body-y;
        width: root.stats-w;
        height: root.body-h;
        background: Palette.panel;
        border-radius: 8px;
        // Заголовок и выбранные блоки — квадратик цвета их линии и название; справа — сколько срезов и за какое время.
        stats-head := HorizontalLayout {
            x: root.pad;
            y: 4px;
            height: 24px;
            spacing: 10px;
            alignment: start;
            Text { text: "Статистика"; color: Palette.dim; font-weight: 600; vertical-alignment: center; }
            for l[i] in root.stats-legend: Rectangle {
                width: item.preferred-width;
                item := HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 10px;
                        Rectangle { y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 2px; background: l.color; }
                    }
                    Text { text: l.name; color: Palette.text; font-size: 12px; vertical-alignment: center; }
                }
                TouchArea {
                    changed has-hover => {
                        root.tip(self.has-hover, "legend" + i, l.tip, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                    }
                }
            }
        }
        Text {
            x: root.pad + stats-head.preferred-width + 12px;
            y: 4px;
            height: 24px;
            width: parent.width - root.pad - self.x;
            text: root.stats-note;
            color: Palette.dim;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        // Что значат линии; справа — какая линия подсвечивается.
        HorizontalLayout {
            x: root.pad;
            y: root.head-h;
            height: 18px;
            spacing: 5px;
            alignment: start;
            Rectangle {
                width: 16px;
                Rectangle { y: (parent.height - 3px) / 2; width: 16px; height: 3px; background: Palette.dim; }
            }
            Text { text: "ø средняя"; color: Palette.dim; font-size: 11px; vertical-alignment: center; }
            Rectangle { width: 4px; }
            Text { text: "▲ наибольшая, °C"; color: Palette.dim; font-size: 11px; vertical-alignment: center; }
            Rectangle { width: 4px; }
            Rectangle {
                width: 10px;
                Rectangle {
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Palette.panel;
                    border-width: 1.5px;
                    border-color: Palette.dim;
                    Rectangle { x: 2.5px; y: 2.5px; width: 5px; height: 5px; border-radius: 2.5px; background: Palette.dim; }
                }
            }
            Text { text: "заливка — ø нагрузка"; color: Palette.dim; font-size: 11px; vertical-alignment: center; }
        }
        TouchArea {
            x: root.pad;
            y: root.head-h;
            width: 330px;
            height: 18px;
            changed has-hover => {
                root.tip(self.has-hover, "lines", "Линии выбранных блоков\nПо всем срезам, при любой нагрузке: на каждом фактическом множителе — ø средняя температура (толстая линия) и ▲ наибольшая (тонкая).\n• заливка точки — ø нагрузка: пустая — 0 %, полная — 100 %\n• оси общие для всех блоков — графики можно сравнивать\n• красная линия — отсечка автомодуля\n• числа — в подсказке столбца множителя: сколько времени, ø нагрузка, при каком множителе, нагрузке и когда была ▲", self.absolute-position.x, self.absolute-position.y, self.width, self.height);
            }
        }
        // Переключатель подсветки: «курсор» — линия под курсором (или плитки под курсором) поверх остальных;
        // «закреплённая» — последний добавленный блок или линия, по которой щёлкнули.
        HorizontalLayout {
            // Ширина — по содержимому: без неё раскладка шириной в панель растягивает надпись и уводит кнопки за край.
            x: parent.width - root.pad - self.width;
            y: root.head-h - 2px;
            width: self.preferred-width;
            height: 22px;
            spacing: 4px;
            alignment: end;
            Text { text: "подсветка:"; color: Palette.dim; font-size: 11px; vertical-alignment: center; }
            hover-chip := Rectangle {
                width: hover-text.preferred-width + 14px;
                border-radius: 4px;
                background: !root.pin-mode ? Palette.line : hover-touch.has-hover ? Palette.cell : transparent;
                border-width: 1px;
                border-color: Palette.cell;
                hover-text := Text { text: "под курсором"; color: !root.pin-mode ? Palette.text : Palette.dim; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                hover-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mode-changed(false); }
                    changed has-hover => {
                        root.tip(self.has-hover, "mode-hover", "Подсветка под курсором\nНаведи на линию или на плитку выбранного блока — его линия поверх остальных, остальные бледнее; курсор ушёл — все одинаковы.", self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                    }
                }
            }
            pin-chip := Rectangle {
                width: pin-text.preferred-width + 14px;
                border-radius: 4px;
                background: root.pin-mode ? Palette.line : pin-touch.has-hover ? Palette.cell : transparent;
                border-width: 1px;
                border-color: Palette.cell;
                pin-text := Text { text: "закреплённая"; color: root.pin-mode ? Palette.text : Palette.dim; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                pin-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mode-changed(true); }
                    changed has-hover => {
                        root.tip(self.has-hover, "mode-pin", "Закреплённая подсветка\nПоверх остальных всегда одна линия: последнего добавленного блока или та, по которой щёлкнули на графике; остальные бледнее.", self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                    }
                }
            }
        }
        Text {
            x: root.pad;
            y: parent.height - root.pad - root.actions-h - 24px;
            text: root.stats-legend.length > 1 ? "Автомодуль · действия с выбранными блоками" : "Автомодуль · действия с этим блоком";
            color: Palette.dim;
            font-weight: 600;
            font-size: 12px;
        }
    }
    Chart {
        x: root.stats-x + root.pad - 4px;
        y: root.chart-y;
        width: root.stats-w - 2 * root.pad + 4px;
        height: root.chart-h;
        series: root.chart-series;
        cols: root.chart-cols;
        yticks: root.chart-yticks;
        empty: root.chart-empty;
        columns: root.chart-columns;
        cutoff: root.chart-cutoff;
        cutoff-text: root.chart-cutoff-text;
        tip(on, key, text, x, y, w, h) => { root.tip(on, key, text, x, y, w, h); }
        pointer(x, y, w, h) => { root.chart-pointer(x, y, w, h); }
        exited() => { root.chart-left(); }
        clicked-at(x, y, w, h) => { root.chart-click(x, y, w, h); }
    }
    Lines {
        x: root.stats-x + root.pad;
        y: root.body-y + root.body-h - root.pad - root.actions-h;
        width: root.stats-w - 2 * root.pad;
        height: root.actions-h;
        rows: root.actions;
        empty: root.actions-empty;
        marks: root.stats-legend.length > 1;
        tip(on, key, text, x, y, w, h) => { root.tip(on, key, text, x, y, w, h); }
    }

    // Меню потолка — слой поверх окна, а не PopupWindow: в Slint 1.18 всплывающее окно не сообщает, что его
    // закрыли щелчком мимо, а Rust и скрытой проверке нужно знать, открыто ли меню. Закрывают его щелчок мимо и Esc.
    keys := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (root.menu-shown && event.text == Key.Escape) {
                root.menu-shown = false;
                return accept;
            }
            reject
        }
    }

    if root.menu-shown: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.menu-shown = false;
            }
        }
    }

    if root.menu-shown: Rectangle {
        x: root.menu-left;
        y: root.menu-top;
        width: root.menu-w;
        height: root.menu-h;
        background: Palette.panel;
        border-color: Palette.cell;
        border-width: 1px;
        border-radius: 6px;
        TouchArea { }  // щелчок по заголовку меню не проваливается в слой под ним и не закрывает меню
        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            VerticalLayout {
                padding-left: 12px;
                height: root.menu-head-h - 5px;
                alignment: center;
                Text { text: root.menu-title; color: Palette.dim; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "◆ заводской"; color: Palette.dim; }
                    Text { text: "○ было"; color: Palette.dim; }
                    Text { text: "выше заводского"; color: Palette.bad; }
                }
            }
            Rectangle { height: 1px; background: Palette.cell; }
            Flickable {
            content-height: root.menu-entries.length * root.entry-h;
            VerticalLayout {
            for entry in root.menu-entries: Rectangle {
                height: root.entry-h;
                background: touch.has-hover && !root.busy ? Palette.cell : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text { text: entry.checked ? "✓" : ""; width: 14px; color: Palette.text; vertical-alignment: center; }
                    Text { text: entry.text; color: root.busy ? Palette.dim : entry.above ? Palette.bad : Palette.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: entry.hint; color: Palette.dim; vertical-alignment: center; }
                }
                touch := TouchArea {
                    enabled: !root.busy;
                    clicked => {
                        root.limit-chosen(entry.ratio);
                        root.menu-shown = false;
                    }
                }
            }
            }
            }
        }
    }

    // Подсказка поверх всего.
    if root.tip-shown: TipBox {
        text: root.tip-text;
        x: max(4px, min(root.tip-x, root.width - self.width - 4px));
        y: root.tip-y + root.tip-h + 6px + self.height <= root.height - 4px ? root.tip-y + root.tip-h + 6px : max(4px, root.tip-y - self.height - 6px);
    }
}
