{
  // Страница нового окна. Собирает tools\page.ps1: компилятор TypeScript проверяет типы и кладёт JavaScript в page\js\.
  // Связки модулей нет: браузер грузит модули сам, библиотеки находит по карте импорта в index.html (DECISIONS #27).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src",
    "outDir": "../page/js"
  },
  "include": ["src"]
}
